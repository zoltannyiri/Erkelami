generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Page {
  id                String    @id @default(uuid())
  title             String
  slug              String    @unique
  navigationItems   NavigationItem[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model NavigationItem {
  id                String  @id @default(uuid())
  label             String
  sortOrder         Int     @default(0)
  visible           Boolean @default(true)
  menuKey           String  @default("TOP_LEVEL")
  parentId          String?
  parent            NavigationItem?  @relation("NavigationChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children          NavigationItem[] @relation("NavigationChildren")
  pageId            String?
  page              Page?   @relation(fields: [pageId],  references: [id],  onDelete: SetNull)
  externalUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model HomeSection {
  id                String    @id @default(uuid())
  key               String?   @unique
  title             String?
  type              String
  sortOrder         Int       @default(0)
  visible           Boolean   @default(true)
  items             HomeSectionItem[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model HomeSectionItem {
  id                String    @id @default(uuid())
  sectionId         String
  section           HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  imageUrl          String?
  linkUrl           String?
  buttonText       String?
  sortOrder         Int       @default(0)
  visible           Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}